{
  "name": "anything-llm-extension",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch public -e js,jsx,css,html --exec \"yarn dev:build\"",
    "dev:build": "vite build",
    "build": "vite build",
    "lint": "yarn prettier --ignore-path ../.prettierignore --write ./src",
    "preview": "vite preview",
    "translations:verify": "cd src/locales && node verifyTranslations.mjs",
    "translations:normalize": "cd src/locales && node normalizeEn.mjs && cd ../.. && yarn lint && yarn translations:verify",
    "translations:unused": "cd src/locales && node findUnusedTranslations.mjs",
    "translations:prune": "cd src/locales && node findUnusedTranslations.mjs --delete && cd ../.. && yarn translations:normalize",
    "translations:create": "node scripts/translator/index.mjs --all && yarn lint"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.7",
    "i18next": "23.12.1",
    "i18next-browser-languagedetector": "7.2.1",
    "markdown-it": "14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "14.1.3",
    "recharts": "2.12.7",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.40",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.4"
  }
}
